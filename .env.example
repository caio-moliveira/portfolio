# ── OpenRouter (powers the AI chat agent) ──────────────────────────────
# Get a key at https://openrouter.ai/keys
# Either name works — the app reads OPENROUTER_API_KEY first, then API_KEY.
OPENROUTER_API_KEY=sk-or-...

# Optional: override the chat model(s). Comma-separated = fallback order
# (OpenRouter accepts up to 3). Defaults to free models if unset.
# OPENROUTER_MODEL=openai/gpt-oss-20b:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-nano-9b-v2:free

# Optional: a GitHub token lifts the public API rate limit for the live
# projects section (not required — works fine without it).
# GITHUB_TOKEN=ghp_...
